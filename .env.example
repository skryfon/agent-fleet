# Copy to .env and fill in. Never commit .env (see development-plan.md §8 Secrets).

DATABASE_URL=postgres://agentfleet:agentfleet@localhost:5433/agentfleet?sslmode=disable
CONTROL_PLANE_ADDR=:8080

# Admin-facing API auth (project/feature/task/approval routes) and the
# shared secret between control-plane and cmd/supervisor -- the daemon's own
# incoming-request auth AND the deterministic per-run token derivation key
# (internal/supervisor.Handlers.RunTokenSecret). Generate with e.g.
# `openssl rand -hex 32`.
ADMIN_TOKEN=
SUPERVISOR_SECRET=

# cmd/supervisor (P5) -- see deploy/compose.yaml's supervisor service and
# `make runner-image`.
RUNNER_IMAGE=agentfleet-runner
MAX_CONCURRENT_RUNS=3

# dsh runner (wired M1) -- model requests route through OmniRoute via
# @deepseek-ai/dsh-llm-pi-ai's `omni-route` route (config, no af-llm-*
# plugin; see runner/README.md). GH_TOKEN backs af-github's push/gh_pr_create
# inside the runner container (deploy/runner.Dockerfile, D3: no merge tool).
OMNI_ROUTE_API_KEY=
GH_TOKEN=

# Zulip Cloud (hosted, not a local service -- docs/adr/0004,
# deploy/zulip/README.md). Bot credentials for the M3 bridge.
ZULIP_SITE=
ZULIP_BOT_EMAIL=
ZULIP_BOT_API_KEY=
