# Local-HTTP only. TLS is bootstrap step 2 on the real machine
# (development-plan.md §8), not a laptop concern.
:80 {
	handle /healthz {
		reverse_proxy control-plane:8080
	}
	handle /v1/* {
		# text/event-stream (GET /v1/events) streams unbuffered through
		# reverse_proxy by default — no flush_interval needed.
		reverse_proxy control-plane:8080
	}
	handle {
		root * /srv/webapp
		try_files {path} /index.html
		file_server
	}
}
